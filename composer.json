{
  "name": "flinkn/pos-cashles",
  "description": "POS-Cashles sales and inventory management system",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "POSCashles\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
